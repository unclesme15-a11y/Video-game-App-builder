# --- required on the Acer ---
ANTHROPIC_API_KEY=sk-ant-...

# --- optional ---
# GitHub token raises search rate limits for signal ingestion
GITHUB_TOKEN=

# Comma-separated Apple app IDs to scrape reviews from (competitor apps)
APP_STORE_APP_IDS=

# Comma-separated pain-language search phrases for GitHub issues
# GITHUB_SEARCH_QUERIES=wish this existed,no good tool for

# Ollama on the Nitro (LAN address). Engine falls back to cloud when offline.
OLLAMA_URL=http://nitro.local:11434
LOCAL_MODEL=llama3.1:8b

# CLOUD_MODEL=claude-opus-4-8
# MIN_BUILD_THRESHOLD=8.2
# WORKSPACE_DIR=./workspace
# DB_PATH=./engine/database/engine.db
