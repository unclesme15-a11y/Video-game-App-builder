# --- required on the Acer ---
ANTHROPIC_API_KEY=sk-ant-...

# --- optional ---
# GitHub token raises search rate limits for signal ingestion
GITHUB_TOKEN=

# Comma-separated Apple app IDs to scrape reviews from (competitor apps)
APP_STORE_APP_IDS=

# Comma-separated pain-language search phrases for GitHub issues
# GITHUB_SEARCH_QUERIES=wish this existed,no good tool for

# Ollama on the Nitro (LAN address). Engine falls back to cloud when offline.
OLLAMA_URL=http://nitro.local:11434
LOCAL_MODEL=llama3.1:8b

# --- publishing (free stores) ---
# itch.io: API key from https://itch.io/user/settings/api-keys
# BUTLER_API_KEY is read by the butler CLI on the Nitro; ITCHIO_API_KEY by the
# tracker on the Acer (they can be the same key).
ITCHIO_USER=
ITCHIO_API_KEY=
BUTLER_API_KEY=

# Amazon Appstore: LWA security profile attached to the App Submission API
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=

# Downloads on a free store before an app is flagged worth the $25 Google Play
# PROMOTE_DOWNLOAD_THRESHOLD=500

# CLOUD_MODEL=claude-opus-4-8
# MIN_BUILD_THRESHOLD=8.2
# WORKSPACE_DIR=./workspace
# DB_PATH=./engine/database/engine.db
